	"Entek" "Teken" "Dakol" "Berak"
	"Rejal" "Kornek" "Makbar" "Belor"
	"Keleras" "Kevanak" "Desark" "Prellak"
	"Draxon" "Prekon" "Veridon" "Kezaran"
	"Teraxa" "Grevik" "Crovax" "Raxarek"
	"Tulkes" "Karmak" "Antharn" "Kelak"                                 

